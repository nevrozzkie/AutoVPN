#!/bin/sh
set -eu
umask 077

LANE="${4:-vpn}"
case "$LANE" in
	vpn)
		ROOT=/etc/autovpn/runtime
		SERVICE=/etc/init.d/autovpn-tunnel
		TUN=avpn0
		BRIDGE=br-avpn
		HEALTH_PORT=1088
		ROUTE_TABLE=20191
		ROUTE_PRIORITY=20191
		UNREACHABLE_PRIORITY=20192
		AWG_DEVICE=avpnwg0
		AWG_TABLE=20193
		AWG_MARK_HEX=0x4ee1
		AWG_PRIORITY=20193
		AWG_UNREACHABLE_PRIORITY=20194
		GUARD_TABLE=autovpn_vpn
		;;
	vpn_zapret)
		ROOT=/etc/autovpn/runtime-zapret
		SERVICE=/etc/init.d/autovpn-tunnel-zapret
		TUN=avpn1
		BRIDGE=br-avpnz
		HEALTH_PORT=1108
		ROUTE_TABLE=20211
		ROUTE_PRIORITY=20211
		UNREACHABLE_PRIORITY=20212
		AWG_DEVICE=avpnwg1
		AWG_TABLE=20213
		AWG_MARK_HEX=0x4ef5
		AWG_PRIORITY=20213
		AWG_UNREACHABLE_PRIORITY=20214
		GUARD_TABLE=autovpn_vpn_zapret
		;;
	*) printf '%s\n' '{"ok":false,"code":"invalid_runtime_lane"}'; exit 1 ;;
esac
SCRATCH="$(mktemp -d "/tmp/autovpn-runtime-$LANE.XXXXXX")" || exit 1
cleanup() {
	rm -f "$SCRATCH/result.json" "$SCRATCH/zapret-status.json" "$SCRATCH/table.txt" "$SCRATCH/rules.txt" "$SCRATCH/all-routes.txt" "$SCRATCH/routes.txt" "$SCRATCH/awg-routes.txt" "$SCRATCH/probe-result.json"
	rmdir "$SCRATCH"
}
trap cleanup EXIT
GATE_ROOT=/etc/autovpn/state
HELPER=/usr/libexec/autovpn/runtime-helper.uc
SHARE=/usr/share/autovpn
AWG_HELPER=/usr/libexec/autovpn/awg-helper.uc
PROBE_HELPER=/usr/libexec/autovpn/probe-helper.uc
ZAPRET_HELPER=/usr/libexec/autovpn/zapret-helper.uc

error() { printf '{"ok":false,"code":"%s"}\n' "$1"; exit 1; }
ok() { printf '%s\n' '{"ok":true}'; }

guard() {
	if [ "$1" = open ]; then zapret check || return 1; fi
	# Never replace an unrelated table with the same name.
	if nft list table inet "$GUARD_TABLE" >"$SCRATCH/table.txt" 2>/dev/null; then
		grep -q 'chain ownership_autovpn_v1' "$SCRATCH/table.txt" || return 1
	fi
	nft -f "$SHARE/guard-$LANE-$1.nft" >/dev/null 2>&1
}
closed() {
	# Stop the tunnel even if a foreign/broken nft table prevents guard installation.
	guard_ok=0
	guard closed && guard_ok=1
	"$SERVICE" stop >/dev/null 2>&1 || return 1
	[ ! -f "$ROOT/awg-owned" ] || ucode "$AWG_HELPER" down '' "$LANE" >/dev/null 2>&1 || return 1
	zapret down || return 1
	[ "$guard_ok" -eq 1 ]
}
helper() { ucode "$HELPER" "$1" "$JOURNAL" "${2:-}" "$LANE" 2>/dev/null >"$SCRATCH/result.json"; }
empty() { grep -Eq '"empty"[[:space:]]*:[[:space:]]*true' "$SCRATCH/result.json"; }
zapret() {
	# Explicit helper state always wins over stale files from another schema.
	owner="$SCRATCH/result.json"
	if ! grep -Eq '"legacy_transport"[[:space:]]*:' "$owner" 2>/dev/null; then
		owner="$SCRATCH/zapret-status.json"
		ucode "$HELPER" status "$JOURNAL" '' "$LANE" >"$owner" 2>/dev/null || return 0
	fi
	# A schema-3 secondary is intentionally empty and must not stop the legacy
	# engine owned by the primary lane. Ambiguous state never shuts another lane.
	grep -Eq '"empty"[[:space:]]*:[[:space:]]*true' "$owner" 2>/dev/null && return 0
	if [ "$LANE" = vpn ]; then
		grep -Eq '"legacy_transport"[[:space:]]*:[[:space:]]*true' "$owner" || return 0
	else
		grep -Eq '"legacy_transport"[[:space:]]*:[[:space:]]*false' "$owner" || return 0
	fi
	ucode "$ZAPRET_HELPER" "$1" "$ROOT/zapret.json" "$LANE" >/dev/null 2>&1
}
check() { sing-box check -c "$ROOT/candidate.json" >/dev/null 2>&1 && zapret validate; }
awg_active() { grep -q '"private_key"' "$ROOT/awg.json" 2>/dev/null; }
selected_awg() { grep -Eq '"active_profile"[[:space:]]*:[[:space:]]*"amneziawg"' "$SCRATCH/result.json"; }
awg_up() { ucode "$AWG_HELPER" up "$ROOT/awg.json" "$LANE" >/dev/null 2>&1; }
awg_healthy() {
	awg_active && cmp -s "$ROOT/awg.json" "$ROOT/awg-run.json" &&
		ucode "$AWG_HELPER" check "$ROOT/awg.json" "$LANE" >/dev/null 2>&1
}

routes() {
	# Fixed table/priority ownership. Refuse collisions; never flush a route table.
	ip -4 rule show >"$SCRATCH/rules.txt" 2>/dev/null || return 1
	for priority in "$ROUTE_PRIORITY" "$UNREACHABLE_PRIORITY"; do
		lines="$(grep -E "^$priority:" "$SCRATCH/rules.txt" || true)"
		if [ "$priority" = "$ROUTE_PRIORITY" ]; then
			expected="$priority: from all iif $BRIDGE lookup $ROUTE_TABLE"
		else
			expected="$priority: from all iif $BRIDGE unreachable"
		fi
		[ -z "$lines" ] || [ "$(printf '%s' "$lines" | tr -s '[:space:]' ' ')" = "$expected" ] || return 1
	done
	# Dump all tables: querying an empty numbered table alone can return ENOENT.
	# Numeric output also prevents rt_tables aliases from hiding a collision.
	ip -N -4 route show table all >"$SCRATCH/all-routes.txt" 2>/dev/null || return 1
	grep -E " table $ROUTE_TABLE( |$)" "$SCRATCH/all-routes.txt" >"$SCRATCH/routes.txt" || true
	while IFS= read -r route; do
		[ "$route" = "default dev $TUN table $ROUTE_TABLE" ] ||
			[ "$route" = "default dev $TUN table $ROUTE_TABLE scope 253" ] || return 1
	done <"$SCRATCH/routes.txt"
	# The unreachable rule survives TUN disappearance, preventing main-table fallback.
	grep -q "^$UNREACHABLE_PRIORITY:" "$SCRATCH/rules.txt" || ip -4 rule add priority "$UNREACHABLE_PRIORITY" iif "$BRIDGE" unreachable || return 1
	grep -q "^$ROUTE_PRIORITY:" "$SCRATCH/rules.txt" || ip -4 rule add priority "$ROUTE_PRIORITY" iif "$BRIDGE" lookup "$ROUTE_TABLE" || return 1
	ip -4 route replace default dev "$TUN" table "$ROUTE_TABLE" >/dev/null 2>&1 || return 1
	if ! awg_active; then return 0; fi
	# sing-box marks plaintext entering the AWG device. AWG marks its own UDP
	# socket differently, so the encrypted outer packet keeps the WAN route.
	for priority in "$AWG_PRIORITY" "$AWG_UNREACHABLE_PRIORITY"; do
		lines="$(grep -E "^$priority:" "$SCRATCH/rules.txt" || true)"
		if [ "$priority" = "$AWG_PRIORITY" ]; then
			expected="$priority: from all fwmark $AWG_MARK_HEX lookup $AWG_TABLE"
		else
			expected="$priority: from all fwmark $AWG_MARK_HEX unreachable"
		fi
		[ -z "$lines" ] || [ "$(printf '%s' "$lines" | tr -s '[:space:]' ' ')" = "$expected" ] || return 1
	done
	grep -E " table $AWG_TABLE( |$)" "$SCRATCH/all-routes.txt" >"$SCRATCH/awg-routes.txt" || true
	while IFS= read -r route; do
		[ "$route" = "default dev $AWG_DEVICE table $AWG_TABLE" ] ||
			[ "$route" = "default dev $AWG_DEVICE table $AWG_TABLE scope 253" ] || return 1
	done <"$SCRATCH/awg-routes.txt"
	grep -q "^$AWG_UNREACHABLE_PRIORITY:" "$SCRATCH/rules.txt" || ip -4 rule add priority "$AWG_UNREACHABLE_PRIORITY" fwmark "$AWG_TABLE" unreachable || return 1
	grep -q "^$AWG_PRIORITY:" "$SCRATCH/rules.txt" || ip -4 rule add priority "$AWG_PRIORITY" fwmark "$AWG_TABLE" lookup "$AWG_TABLE" || return 1
	# An unavailable optional AWG candidate must neither leak through WAN nor
	# prevent routing the currently selected VLESS/Hysteria tunnel.
	ip link show dev "$AWG_DEVICE" >/dev/null 2>&1 || { ! selected_awg; return; }
	ip -4 route replace default dev "$AWG_DEVICE" table "$AWG_TABLE" >/dev/null 2>&1
}
start() {
	local hard_awg_failure=0 fallback_profile
	closed || return 1
	# The scoped queue/listener must exist before AWG or sing-box send a handshake.
	zapret up || return 1
	if awg_active && ! awg_up; then
		[ ! -f "$ROOT/awg-owned" ] || ucode "$AWG_HELPER" down '' "$LANE" >/dev/null 2>&1 || return 1
		if selected_awg; then
			# A kernel-interface failure is definite, not a slow-network sample.
			# Stage a non-AWG probe runtime; manual AWG is deliberately refused.
			helper fallback-awg || return 1
			hard_awg_failure=1
		else
			helper disable-awg || return 1
		fi
		check || return 1
		zapret up || return 1
	fi
	if awg_active; then
		cp "$ROOT/awg.json" "$ROOT/awg-run.json.new" || return 1
		mv "$ROOT/awg-run.json.new" "$ROOT/awg-run.json" || return 1
	else
		rm -f "$ROOT/awg-run.json"
	fi
	cp "$ROOT/candidate.json" "$ROOT/run.json.new" || return 1
	mv "$ROOT/run.json.new" "$ROOT/run.json" || return 1
	"$SERVICE" start >/dev/null 2>&1 || return 1
	attempt=0
	while ! ip link show dev "$TUN" >/dev/null 2>&1; do
		attempt=$((attempt + 1))
		[ "$attempt" -lt 6 ] || return 1
		sleep 1
	done
	"$SERVICE" running >/dev/null 2>&1 || return 1
	routes || return 1
	if [ "$hard_awg_failure" -eq 1 ]; then
		ucode "$PROBE_HELPER" bootstrap "$JOURNAL" '' "$LANE" >"$SCRATCH/probe-result.json" 2>/dev/null || return 1
		fallback_profile="$(jsonfilter -i "$SCRATCH/probe-result.json" -e '@.next_profile' 2>/dev/null || true)"
		case "$fallback_profile" in vless-reality|hysteria2) ;; *) return 1 ;; esac
		helper fallback-awg "$fallback_profile" && check || return 1
		# The staged runtime now has no AWG, so recursion cannot re-enter fallback.
		start || return 1
		ucode "$PROBE_HELPER" confirm "$JOURNAL" "$fallback_profile" "$LANE" >"$SCRATCH/probe-result.json" 2>/dev/null || return 1
		grep -Eq '"healthy"[[:space:]]*:[[:space:]]*true' "$SCRATCH/probe-result.json" || return 1
		helper commit-profile "$fallback_profile" || return 1
	fi
	# Forwarding stays closed until verify has reached the VPN over HTTPS.
}
probe() {
	# Fixed URL and dedicated SOCKS inbound cannot match a direct exception.
	code="$(curl --disable --silent --output /dev/null --write-out '%{http_code}' \
		--proxy "socks5h://127.0.0.1:$HEALTH_PORT" --noproxy '' --proto '=https' \
		--connect-timeout 4 --max-time 10 --max-redirs 0 \
		https://www.gstatic.com/generate_204 2>/dev/null)" || return 1
	[ "$code" = 204 ]
}
monitor() {
	# Only this path may fail over. ping-all never invokes it.
	PROBE_RESULT="$SCRATCH/probe-result.json"
	ucode "$PROBE_HELPER" "$1" "$JOURNAL" '' "$LANE" >"$PROBE_RESULT" 2>/dev/null || return 1
	if grep -Eq '"healthy"[[:space:]]*:[[:space:]]*true' "$PROBE_RESULT"; then
		guard open || return 1
		return 0
	fi
	if grep -Eq '"failed"[[:space:]]*:[[:space:]]*false' "$PROBE_RESULT"; then
		# A transient failure is not a reason to switch or restart a live VPN.
		[ "$1" != recover ] || return 1
		return 0
	fi
	grep -Eq '"failed"[[:space:]]*:[[:space:]]*true' "$PROBE_RESULT" || return 1
	guard closed || return 1
	next="$(jsonfilter -i "$PROBE_RESULT" -e '@.next_profile' 2>/dev/null || true)"
	case "$next" in
		vless-reality|hysteria2|amneziawg)
			helper select-profile "$next" || return 1
			check || return 1
			start || return 1
			# start may recover a definitively failed AWG device with a verified
			# non-AWG profile; verify the actual result, not the original request.
			next="$(jsonfilter -i "$SCRATCH/result.json" -e '@.active_profile' 2>/dev/null || true)"
			case "$next" in vless-reality|hysteria2|amneziawg) ;; *) return 1 ;; esac
			# Re-test after activation; an earlier probe is not a commit guarantee.
			ucode "$PROBE_HELPER" confirm "$JOURNAL" "$next" "$LANE" >"$PROBE_RESULT" 2>/dev/null || return 1
			grep -Eq '"healthy"[[:space:]]*:[[:space:]]*true' "$PROBE_RESULT" || return 1
			helper commit-profile "$next" || return 1
			guard open || return 1
			;;
		*)
			# Keep candidate listeners alive so the next round can observe recovery.
			# The client network remains closed; there is never a WAN fallback.
			[ "$1" != recover ] || return 1
			;;
	esac
}
preflight() {
	# A poll/reboot must not open a network whose setup is unconfirmed or conflicted.
	ucode /usr/libexec/autovpn/network-helper.uc network-gate >/dev/null 2>&1 || return 1
	command -v sing-box >/dev/null && command -v nft >/dev/null && command -v ip >/dev/null || return 1
	# Flow offload can bypass filter hooks, including the kill switch.
	[ "$(uci -q get 'firewall.@defaults[0].flow_offloading' || true)" != 1 ] || return 1
	[ "$(uci -q get 'firewall.@defaults[0].flow_offloading_hw' || true)" != 1 ] || return 1
	nft list chain inet fw4 forward 2>/dev/null | grep -q "$BRIDGE" || return 1
	ip link show dev "$BRIDGE" >/dev/null 2>&1 || return 1
}

mkdir -p "$ROOT"
chmod 0700 /etc/autovpn "$ROOT"
JOURNAL="${2:-/etc/autovpn/state/journal.json}"
case "${1:-}" in
	prepare|activate|verify|rollback|restore|health-tick|ping-all)
		for gate in "$GATE_ROOT/maintenance.lock" "$GATE_ROOT/update.lock"; do
			if [ -e "$gate" ] || [ -L "$gate" ]; then
				if [ "${1:-}" != ping-all ]; then
					closed || error fail_closed_unconfirmed
				fi
				error maintenance_locked
			fi
		done
		;;
esac
case "${1:-}" in
	status)
		helper status || { cat "$SCRATCH/result.json"; exit 1; }
		if empty; then cat "$SCRATCH/result.json"; exit 0; fi
		if "$SERVICE" running >/dev/null 2>&1 && ip link show dev "$TUN" >/dev/null 2>&1 && \
			nft list chain inet "$GUARD_TABLE" forward 2>/dev/null | grep -q "$TUN" && \
			{ ! selected_awg || awg_healthy; } && zapret check; then
			cat "$SCRATCH/result.json"
		else
			printf '%s\n' '{"ok":false,"code":"runtime_not_running"}'
			exit 1
		fi
		;;
	capabilities)
		# Availability is advertised only after a rendered configuration is verified.
		printf '%s\n' '{"ok":true,"capabilities":{"vless":false,"hysteria2":false,"amneziawg":false,"zapret":false,"policy_routing":false}}'
		;;
	fail-closed)
		closed || error fail_closed_unconfirmed
		ok
		;;
	prepare)
		helper prepare || { cat "$SCRATCH/result.json"; exit 1; }
		if empty; then cat "$SCRATCH/result.json"; exit 0; fi
		preflight || error runtime_preflight_failed
		check || error sing_box_check_failed
		ok
		;;
	activate)
		helper activate || { cat "$SCRATCH/result.json"; exit 1; }
		if empty; then closed || error fail_closed_unconfirmed; cat "$SCRATCH/result.json"; exit 0; fi
		preflight || error runtime_preflight_failed
		check || error sing_box_check_failed
		start || error runtime_activation_failed
		ok
		;;
	verify)
		helper verify || { cat "$SCRATCH/result.json"; exit 1; }
		if empty; then cat "$SCRATCH/result.json"; exit 0; fi
		zapret check || { closed || true; error zapret_unavailable; }
		probe && probe || monitor recover || error vpn_probe_failed
		guard open || error firewall_activation_failed
		helper verify || { closed || true; error runtime_bundle_mismatch; }
		cat "$SCRATCH/result.json"
		;;
	rollback|restore)
		helper "$1" || { cat "$SCRATCH/result.json"; exit 1; }
		if empty; then
			closed || error fail_closed_unconfirmed
			ok
			exit 0
		fi
		preflight || error runtime_preflight_failed
		check || error sing_box_check_failed
		if [ "$1" = restore ] && cmp -s "$ROOT/candidate.json" "$ROOT/run.json" && \
			{ ! selected_awg || awg_healthy; } && zapret check && \
			"$SERVICE" running >/dev/null 2>&1 && ip link show dev "$TUN" >/dev/null 2>&1; then
			routes || error route_restore_failed
			# Reusing a committed runtime must not bypass failure hysteresis or
			# reselect a faster candidate on subscription refresh.
			cat "$SCRATCH/result.json"
			exit 0
		else
			start || error runtime_restore_failed
		fi
		probe && probe || monitor recover || { closed || true; error vpn_probe_failed; }
		guard open || error firewall_activation_failed
		helper status || { closed || true; error runtime_bundle_mismatch; }
		cat "$SCRATCH/result.json"
		;;
	health-tick)
		preflight || { closed || error fail_closed_unconfirmed; error runtime_preflight_failed; }
		# Reconstruct the committed bundle, including after an interrupted switch.
		helper restore || { closed || true; error runtime_bundle_mismatch; }
		empty && error snapshot_not_applied
		if ! cmp -s "$ROOT/candidate.json" "$ROOT/run.json" || \
			! "$SERVICE" running >/dev/null 2>&1 || ! ip link show dev "$TUN" >/dev/null 2>&1 || \
			{ selected_awg && ! awg_healthy; } || ! zapret check; then
			# Restore the same persisted choice before considering alternatives.
			helper restore || error runtime_bundle_mismatch
			empty && error snapshot_not_applied
			check && start || { closed || true; error runtime_restore_failed; }
		fi
		# procd may have recreated TUN since the last round, losing its routes.
		routes || { closed || true; error route_restore_failed; }
		monitor health || { closed || true; error health_check_failed; }
		helper status || { closed || true; error runtime_bundle_mismatch; }
		cat "$SCRATCH/result.json"
		;;
	ping-all)
		case "${3:-youtube}" in youtube|instagram) ;; *) error invalid_probe_target ;; esac
		# Read-only with respect to runtime/UCI/health; no start/restore/select.
		"$SERVICE" running >/dev/null 2>&1 || error runtime_not_running
		zapret check || error zapret_unavailable
		ucode "$PROBE_HELPER" ping-all "$JOURNAL" "${3:-youtube}" "$LANE"
		;;
	*) error unknown_runtime_action ;;
esac
