table inet autovpn_vpn_zapret
flush table inet autovpn_vpn_zapret
table inet autovpn_vpn_zapret {
	chain ownership_autovpn_v1 {}
	chain forward {
		type filter hook forward priority -10; policy accept;
		iifname "br-avpnz" counter drop
		oifname "br-avpnz" counter drop
	}
	chain input {
		type filter hook input priority -10; policy accept;
		iifname "br-avpnz" meta nfproto ipv4 udp sport 68 udp dport 67 accept
		iifname "br-avpnz" counter drop
	}
}
