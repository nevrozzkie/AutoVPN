config controller 'main'
	option enabled '0'
	option base_url ''
	option router_id ''
	option poll_interval '300'
	option connect_timeout '10'
	option request_timeout '30'
	option credential_file '/etc/autovpn/credentials'
	option state_dir '/etc/autovpn/state'
	option http_adapter '/usr/libexec/autovpn/http-adapter'
	option runtime_adapter '/usr/libexec/autovpn/runtime-adapter'

config runtime 'runtime'
	option selection 'auto'
	option wan_device ''
	option dns_server '1.1.1.1'
	option ru_bypass '1'
	option hysteria_tls_mode 'subscription'
	option zapret_enabled '1'
	option zapret_vless 'split'
	option zapret_hysteria2 'fake'
	option zapret_amneziawg 'off'
	option zapret_repeats '2'
	list direct_domains 'ru'
	list direct_domains 'xn--p1ai'

config wifi 'wifi'
	option base_ssid ''
	option password ''

config runtime 'runtime_zapret'
	option selection 'auto'

# Negative VPN shares the active VPN profile: its final route is direct and
# only explicitly selected domain/IP rules use that profile.
config runtime 'runtime_negative'
	option negative_telegram '0'
	option negative_youtube '0'
	option negative_instagram '0'
	option negative_x '0'
	option negative_chatgpt '0'
	option negative_claude '0'
	option negative_discord '0'
	option negative_facebook '0'
	option negative_linkedin '0'
	option negative_reddit '0'
	option negative_tiktok '0'
	option negative_soundcloud '0'
	option negative_clubhouse '0'
	option negative_patreon '0'
	option negative_signal '0'
	option negative_twitch '0'
	option negative_viber '0'
	option negative_whatsapp '0'
	option negative_bluesky '0'

config health 'health'
	option probe_url 'https://connectivitycheck.gstatic.com/generate_204'
	option failure_threshold '3'
	option success_threshold '2'
	option cooldown_seconds '60'
	option manual_override 'auto'

config policy 'direct'
	option mode 'direct'
	option ipv6 'block'
	option web_strategy 'upstream'
	option quic_mode 'process'
	option discord_media '1'
	option stun '1'
	option media_strategy 'fake'
	option media_repeats '2'

config policy 'vpn'
	option mode 'vpn'
	option ru_exclusions 'direct'
	option dns 'tunnel_only'
	option failure_mode 'closed'
	option ipv6 'block'

config policy 'zapret'
	option mode 'zapret'
	option ipv6 'block'

config policy 'vpn_zapret'
	option mode 'vpn_zapret'
	option ru_exclusions 'direct'
	option dns 'tunnel_only'
	option failure_mode 'closed'
	option ipv6 'block'
