#!/bin/sh /etc/rc.common
USE_PROCD=1
START=94
STOP=9

start_service() {
	[ -f /etc/autovpn/runtime/run.json ] || return 1
	procd_open_instance vpn
	procd_set_param command /usr/bin/sing-box run -c /etc/autovpn/runtime/run.json
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param file /etc/autovpn/runtime/run.json
	procd_close_instance
}

# Only the controller starts this service after restoring guards and routes.
boot() { return 0; }
