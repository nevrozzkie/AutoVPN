#!/bin/sh /etc/rc.common
USE_PROCD=1
START=97
STOP=9

start_service() {
	[ -r /var/run/autovpn-zapret/nfqws.conf ] || return 1
	procd_open_instance autovpn_zapret
	procd_set_param command /usr/lib/autovpn-zapret/nfqws2 @/var/run/autovpn-zapret/nfqws.conf
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

# Controller-only: install scoped rules before starting this service.
boot() { return 0; }
