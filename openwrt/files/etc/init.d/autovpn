#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

service_triggers() {
	procd_add_reload_trigger autovpn
}

start_service() {
	# The loop also maintains direct-zapret before VPN pairing. Each tick checks
	# the persistent maintenance/network gates before it can open any traffic.
	procd_open_instance
	procd_set_param command /usr/libexec/autovpn/loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param user root
	procd_close_instance
	procd_open_instance routing
	procd_set_param command /usr/libexec/autovpn/ru-db-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param user root
	procd_close_instance
}

reload_service() {
	stop
	start
}

stop_service() {
	/usr/sbin/autovpnctl stop >/dev/null
}
