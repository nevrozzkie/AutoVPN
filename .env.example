# FastAPI/admin
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=./data/autovpn.sqlite3
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-password

# Aeza
AEZA_API_BASE=https://my.aeza.net
AEZA_TOKEN=put-token-here
AEZA_SERVICE_ID=put-service-id-here
AEZA_IPV4_PAYMENT_METHOD=balance
# Optional. HAR showed Aeza UI sends the service name/domain here, for example: aqua
AEZA_IPV4_DOMAIN=
AEZA_IPV4_AFTER_PURCHASE_DELAY_SECONDS=120

# SSH from RU control plane to EU/Aeza VPS for install/sync
# If EU_SSH_HOST is empty, current_ip from SQLite is used.
EU_SSH_HOST=
EU_SSH_USER=root
EU_SSH_PORT=22
EU_SSH_KEY_PATH=/home/autovpn/.ssh/aeza_ed25519
# Optional. If set, password auth is used instead of EU_SSH_KEY_PATH.
EU_SSH_PASSWORD=
SSH_CONNECT_TIMEOUT_SECONDS=15

# Default OFF until the versioned OpenWrt router API is integration-tested.
ENABLE_ROUTER_API=0

# VPN protocol ports
VLESS_PORT=443
VLESS_REALITY_TARGET=ok.ru:443
VLESS_REALITY_SERVER_NAMES=ok.ru,www.ok.ru
VLESS_REALITY_SERVER_NAME=ok.ru
VLESS_REALITY_FINGERPRINT=firefox
VLESS_REALITY_SPIDER_X=/
HYSTERIA_PORT=8443
AMNEZIA_PORT=51820
AMNEZIA_NETWORK_PREFIX=10.66.66
AMNEZIA_DNS=1.1.1.1, 8.8.8.8
SSH_PORT=22

# State machine timings
IP_APPEAR_TIMEOUT_SECONDS=300
IP_APPEAR_INTERVAL_SECONDS=5
REBOOT_WAIT_SECONDS=30
HEALTHCHECK_TIMEOUT_SECONDS=300
HEALTHCHECK_INTERVAL_SECONDS=10
